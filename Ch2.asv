% acceleration d2x/dt2
% acceleration 

% Without Symbolic Math toolbox
% a = dv/dt
% dv = a dt

a = 5;
dt = 0.000001; % must be 1 million time smaller to be precise
t1 = 0;
t2 = 10;
v = 0;
for t = t1:dt:t2
    v = v + a * dt;
end
v

% With Symbolic Math toolbox

syms v(t) a t
a = 5;
v(t) = @(t) a * t
v(5)

